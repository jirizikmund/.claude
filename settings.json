{
  "permissions": {
    "allow": [
      "mcp__appium-mcp__*",
      "Bash(curl*localhost:4723*)",
      "Bash(xcrun simctl*)",
      "Bash(adb *)",
      "Bash(pgrep*)",
      "Bash(pkill*appium*)",
      "Bash(appium*)",
      "Bash(mkdir -p*app-screens*)",
      "Bash(mv */app-screens/*)",
      "Bash(sleep*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__appium-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "pgrep -f 'appium.*--port' > /dev/null || (appium --port 4723 > /tmp/appium.log 2>&1 & sleep 3)"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pkill -f 'appium.*--port' || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  }
}
