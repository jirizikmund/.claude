{
  "env": {
    "TAVILY_API_KEY": "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"
  },
  "permissions": {
    "allow": [
      "mcp__appium-mcp__*",
      "Bash(curl*localhost:4723*)",
      "Bash(xcrun simctl*)",
      "Bash(adb *)",
      "Bash(pgrep*)",
      "Bash(pkill*appium*)",
      "Bash(appium*)",
      "Bash(mkdir -p*app-screens*)",
      "Bash(mv */app-screens/*)",
      "Bash(sleep*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__appium-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "pgrep -f 'appium.*--port' > /dev/null || (appium --port 4723 > /tmp/appium.log 2>&1 & sleep 3)"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pkill -f 'appium.*--port' || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Blow.aiff &"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Blow.aiff &"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/jiri/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "figma@claude-plugins-official": true
  },
  "language": "czech",
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "terminal_bell",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "skipAutoPermissionPrompt": true,
  "effortLevel": "xhigh"
}
