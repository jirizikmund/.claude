# Ignore everything by default
*

# Allow gitignore itself
!.gitignore

# Core config
!CLAUDE.md
!settings.json

# Local project settings (permissions)
!.claude/
!.claude/settings.local.json

# Custom agents
!agents/
!agents/*.md

# Plugin configuration (not cache/repos)
!plugins/
!plugins/blocklist.json
!plugins/installed_plugins.json
!plugins/known_marketplaces.json

# Plans
!plans/
!plans/*.md

# Project configs and memory (not session logs)
!projects/
!projects/*/
!projects/*/CLAUDE.md
!projects/*/memory/
!projects/*/memory/**
!projects/*/memory/**/*.md
