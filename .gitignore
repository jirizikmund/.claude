# Ignore everything by default
*

# Allow gitignore itself
!.gitignore

# Core config
!CLAUDE.md
!settings.json

# Local project settings (permissions)
!.claude/
!.claude/settings.local.json

# Custom agents
!agents/
!agents/*.md

# Plugin configuration (not cache/repos)
!plugins/
!plugins/blocklist.json
!plugins/installed_plugins.json
!plugins/known_marketplaces.json

# Plans
!plans/
!plans/*.md

# Project configs and memory (not session logs)
!projects/
!projects/*/
!projects/*/CLAUDE.md
!projects/*/memory/
!projects/*/memory/**
!projects/*/memory/**/*.md
# Screenshoty z memory NEverzovat (binární balast — zůstávají jen na disku)
projects/*/memory/screenshots/

# Custom skills (symlinky na externí skills se uloží jen jako odkazy)
!skills/
!skills/**

# Paměť custom agentů
!agent-memory/
!agent-memory/**

# Globální MCP servery
!.mcp.json

# Statusline skript
!statusline-command.sh

# macOS balast (i v povolených adresářích)
**/.DS_Store
